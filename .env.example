# Clé API Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Adresse e-mail transmise à l'API NCBI E-utilities.
# Requise par leur politique d'usage : elle leur permet de vous contacter
# plutôt que de bloquer votre IP si une requête pose problème.
NCBI_EMAIL=votre.email@exemple.fr
